# Rust / Cargo build artifacts
target/
**/*.rs.bk
*.pdb

# Editor / IDE
.idea/
.vscode/
# But vendored crates' .vscode/ directories must be committed for offline Flatpak builds
!/vendor/**/.vscode/
*.swp
*.swo
*~
*.bak
.DS_Store

# Plan-task workspace scratch (ephemeral scratchpads)
.specs/scratchpad/

# Local config / secrets
.env
.env.local

# Fuzzing source is tracked (fuzz/Cargo.toml + fuzz/fuzz_targets/*.rs).
# Only build output, libFuzzer-mined corpus, and crash artifacts are ignored.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
**/fuzz/artifacts/

# Coverage / profdata
*.profraw
*.profdata
coverage/

# Build output of any local tooling (Flatpak build dirs are gitignored too)
build-dir/
.flatpak-builder/
.flatpak/
